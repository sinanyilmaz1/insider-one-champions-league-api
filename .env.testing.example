APP_ENV=testing
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=insider_one_test
DB_USERNAME=insider_one
DB_PASSWORD=insider_one_local_password

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Loopback unused port — connection refused fires instantly so tests don't
# wait for DNS / connect timeouts when a test forgets to mock the service.
PREDICTION_SERVICE_URL=http://127.0.0.1:1
PREDICTION_SERVICE_AUTH_TOKEN=test-secret
PREDICTION_SERVICE_TIMEOUT=1

CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_READ=60
RATE_LIMIT_MUTATE=20
